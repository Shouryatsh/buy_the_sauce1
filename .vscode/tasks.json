{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Options Wheel Dashboard",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m", "streamlit", "run", "wheel_dashboard.py",
                "--server.headless", "true",
                "--server.port", "8501"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^never_matches_anything$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "You can now view your Streamlit app"
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "optionsdesk: API + agents (simulated, offline)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "optionsdesk", "serve", "--simulated", "--port", "8000"],
            "options": {"cwd": "${workspaceFolder}"},
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "optionsdesk: API + agents (LIVE, IBKR 7496)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "optionsdesk", "serve", "--port", "8000", "--i-understand-live"],
            "options": {"cwd": "${workspaceFolder}"},
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "optionsdesk: dashboard (port 8502)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "optionsdesk", "dashboard", "--port", "8502"],
            "options": {"cwd": "${workspaceFolder}"},
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run Dashboard",
            "type": "shell",
            "command": "python3",
            "args": [
                "dashboard.py"
            ],
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
